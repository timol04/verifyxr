{
  "name": "formacheck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Client-seitiger Format-Checker für wissenschaftliche Arbeiten (.docx), ohne Backend.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "inspect": "node scripts/inspect-docx.mjs",
    "make-fixture": "python3 scripts/make-fixture.py && python3 scripts/make-fixture-apa.py",
    "test": "node --test test/*.test.mjs",
    "license": "node scripts/license.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "fast-xml-parser": "^4.5.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "vite": "^5.4.0"
  }
}
